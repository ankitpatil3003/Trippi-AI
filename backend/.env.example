MCP_STUB=true
MCP_STUB_RAINY=false
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
WEATHER_MCP_URL=
RESEARCH_MCP_URL=
DINING_MCP_URL=
RESEARCH_MCP_STUB=true
DINING_MCP_STUB=true
DATE_SHIFT_RAIN_RATIO=0.35
DATE_SHIFT_MIN_IMPROVEMENT=0.12

# LLM provider: heuristic | openrouter | anthropic | openai
# Free (recommended for demos): openrouter + openrouter/free
# Cheap quality: anthropic + claude-haiku-4-5
LLM_PROVIDER=heuristic
LLM_MODEL=

# OpenRouter (https://openrouter.ai/keys). Free router model works with no credit card for light use.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Anthropic (https://console.anthropic.com/). Haiku is efficient for this project.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8080
